# Machine configuration template for the GLM5.2 single-card golden pipeline.
#
# Copy to `glm52.env` beside this template (git-ignored by `*.env`) and fill in
# host paths. The runner reads `glm52.env`; it does not use this template.
#
# CANN setup, Conda env and Python default to the sibling `env.sh` values
# `MEGAKERNEL_NPU_CANN_SETUP` / `MEGAKERNEL_NPU_PYTHON` when omitted here.

# Readable checkout used only to export the pinned reference commit.
GLM52_REFERENCE_SOURCE=
GLM52_REFERENCE_COMMIT=

# Isolated reference runtime built by `glm52_single_card.py build`.
GLM52_REFERENCE_HOME=

# Triton-distributed-ascend checkout under test.
GLM52_TD_SOURCE=

# User-owned shmem install used by the reference build.
GLM52_SHMEM_HOME=

# Golden cache and run logs; created on demand.
GLM52_GOLDEN_ROOT=
GLM52_LOG_ROOT=

# Build settings. GLM52_BUILD_JOBS is strictly capped at 16.
GLM52_BUILD_JOBS=16
GLM52_BUILD_PLATFORM=A5
GLM52_BUILD_TYPE=Dump
# Sibling cross compiler for the reference build. Leave empty when the default
# toolchain is correct, otherwise set an absolute path to the intended compiler.
GLM52_CROSS_CXX=
# Directory containing the matched bishengir-opt / bishengir-compile pair used
# by the TD dispatch compiler (CANN 9.3 may ship dangling symlinks).
GLM52_BISHENGIR_BIN=

# Default pipeline shape (device id remains a per-run launch value, never here).
GLM52_TOKENS=8
GLM52_TP_SIZE=1
GLM52_SCOPE=boundaries
