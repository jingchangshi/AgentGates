# Configuration for creating the TLA (Triton-on-Ascend) development container.
#
# This file configures CONTAINER CREATION only. It never holds the Gate's
# variables and never holds CANN/Conda: those live in ../env.sh (see
# ../env.example.sh). The three are decoupled and none reads another.
#
#     cp config.example.env config.env
#     ./create-container.sh --config ./config.env --dry-run
#     ./create-container.sh --config ./config.env
#
# `config.env` is git-ignored: it holds machine-specific identities and paths
# and must not be committed.
#
# EVERY value below is empty on purpose. Sourcing an empty assignment is the same
# as not setting the key, so the script's own default applies and this template
# never pins a value nobody reviewed. The commented lines show the SHAPE of a
# value; none of them is a value from any machine.
#
# Every value is plain Bash, so a list is a space-separated string and the script
# splits it on whitespace. Any value that contains spaces MUST be quoted (a bare
# `VAR=a b` would run `b` as a command when this file is sourced).

# ---------------------------------------------------------------------------
# Image and container identity
# ---------------------------------------------------------------------------
# Image built from ./Dockerfile (see README.md for the build command). It must
# exist locally; the script never pulls implicitly.
# Default when empty: tla-npu-dev:24.04
IMAGE=

# Name of the container to create. Required. Must not already exist.
CONTAINER_NAME=

# Hostname inside the container. Default when empty: CONTAINER_NAME with `_`
# turned into `-`.
CONTAINER_HOSTNAME=

# Account created inside the container. Required. It must equal the Gate's
# TLA_NPU_CONTAINER_USER, but this script never reads that variable.
CONTAINER_USER=

# UID/GID of that account. Required, numeric, non-zero. Set them to the Host
# account that owns the bind-mounted source tree AND the mounted home directory,
# so the container can read ~/.bashrc and write the Triton cache. Get the real
# values with:
#     stat -c '%u %g' <host home>
# A mismatch makes a login shell in the container fail with "Permission denied"
# on ~/.bashrc; create-container.sh rejects it before creating anything.
CONTAINER_UID=
CONTAINER_GID=

# Supplementary GIDs added to the account. Default when empty: none. Common
# values are the host group that owns the driver device nodes, and the docker
# group. Illustrative shape: a space-separated list of numeric GIDs.
#   SUPPLEMENTARY_GIDS=100 998 1001
SUPPLEMENTARY_GIDS=

# HOME inside the container. Required, absolute, not `/`. It is normally covered
# by the /home bind mount; the scripts never create or chown it.
CONTAINER_HOME=

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
# Network mode. Default when empty: host, which is what the Ascend tooling and
# the CANN runtime expect.
NETWORK=

# Run privileged. Default when empty: true. Ascend device access generally needs
# it. NOTE: the Gate does NOT detect --privileged; setting it is a deliberate
# operator decision, not something the Gate checks.
PRIVILEGED=

# cgroup namespace mode. Default when empty: host, which matches the reference
# environment. It is also not Gate-detected.
CGROUPNS=

# --security-opt values, space separated. Default when empty: label=disable,
# which is SELinux-only and harmless elsewhere.
SECURITY_OPTS=

# Shared memory size and locked-memory limit. Defaults when empty: 512g and
# 150000000000:150000000000. Torch workloads need a large shm, and the CANN
# runtime locks large memory regions.
SHM_SIZE=
MEMLOCK=

# Value of ASCEND_RT_VISIBLE_DEVICES inside the container. Empty or omitted
# both mean "no filtering": the variable is exported empty, which the runtime
# reads as "no restriction". The script has no literal device default, because
# one would let a file that merely leaves the line out expose cards nobody
# allocated. Set the value explicitly to restrict visibility. The Gate takes its
# device from its own TLA_NPU_DEVICE_ID, never from this file.
ASCEND_VISIBLE_DEVICES=

# Explicit device nodes to pass through (space separated). Default when empty:
# none. ASCEND_RT_VISIBLE_DEVICES alone passes no devices: real access needs the
# driver mounts, the device nodes and the host runtime. Leave empty when the host
# has no NPU or the devices are already visible through --privileged.
# Illustrative shape only:
#   NPU_DEVICES=/dev/davinci0 /dev/davinci_manager /dev/devmm_svm /dev/hisi_hdc
NPU_DEVICES=

# ---------------------------------------------------------------------------
# Mounts
# ---------------------------------------------------------------------------
# Required mounts, format `source:destination[:ro|rw]`. A missing source is a
# hard error: create-container.sh never lets Docker create an unexpected
# directory. Keep same-path mounts (`/data:/data`) unless you have a reason to
# remap; the Gate derives the mapping from `docker inspect`, so either form
# works as long as the source tree is reachable.
#
# Two things must be covered or nothing works:
#   * the directory tree holding the test file the Gate runs, or the Gate
#     refuses the run with "not exposed by any bind mount";
#   * the CANN installation and the Conda installation, which are not in the
#     image. Without them the Gate fails closed with "CANN setup not readable".
#
# Illustrative shape only, one data mount holding CANN and Conda plus the home
# directories holding the source tree:
#   BIND_MOUNTS=/data:/data /home:/home
BIND_MOUNTS=

# Optional mounts, same format. A missing source is reported and skipped, not an
# error. This is where the hardware-specific paths belong, so the same script
# works on a machine without an NPU. Illustrative shape only:
#   OPTIONAL_BIND_MOUNTS=/usr/local/Ascend/driver:/usr/local/Ascend/driver
#   /etc/ascend_install.info:/etc/ascend_install.info
#   /usr/local/sbin/npu-smi:/usr/local/sbin/npu-smi
OPTIONAL_BIND_MOUNTS=

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------
# Default when empty: true.
# true:  keep the container alive after identity initialization, which is what
#        the Gate needs.
# false: run CONTAINER_COMMAND instead; the container exits with it.
LONG_RUNNING=

# Command run when LONG_RUNNING=false. Mutually exclusive with LONG_RUNNING=true;
# the script refuses both at once.
CONTAINER_COMMAND=

# Seconds create-container.sh waits for the entrypoint to create and verify the
# container identity before it reports failure. Default when empty: 30.
INIT_TIMEOUT_SECONDS=
