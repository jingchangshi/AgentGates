# The test fixture for provision.py. NO secrets, NO machine paths.
#
# The real file is machine-local and git-ignored (env.sh). A negative suite that
# reads it passes only on the checkout that happens to have one, and fails from a
# clean archive -- measured: every case died with rc=2 (ENV_UNREADABLE) because
# `git archive` does not contain env.sh. This fixture is the checked-in input those
# cases are supposed to run against.
#
# provision.py needs CONTAINER_NAME and IMAGE to be non-empty; IMAGE is the profile
# image name and is only used to say WHICH image the profile pins. The container the
# live case creates is named explicitly with --container, so this fixture name is
# never created by the suite.
CONTAINER_NAME=tf-provision-fixture
IMAGE=tilefoundry-ascend950pr-dev:24.04
CANN_SET_ENV=/nonexistent/cann/set_env.sh
TF_REPO=/nonexistent/TileFoundry
