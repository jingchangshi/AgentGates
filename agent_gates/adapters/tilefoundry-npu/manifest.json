{
  "schemaVersion": 1,
  "id": "tilefoundry-npu",
  "version": "1.0.0",
  "capabilities": [
    "cpu-regression",
    "device-regression"
  ],
  "skills": [],
  "permissions": {
    "sourceWrite": false,
    "hostExecution": true
  },
  "runtimeCompatibility": {
    "engineeringCore": ">=2.0.0"
  },
  "files": {
    "scripts/tilefoundry_host_gate.py": "c7df1fd6a7de292e1e2d5d2a09717a8209cf8d33f2cd4d1b647c82bf9515b9a5"
  },
  "recipes": [
    {
      "id": "tilefoundry-npu.cpu",
      "cwd": "source",
      "timeout": 660,
      "device": "none",
      "argv": [
        "python3",
        "-B",
        "{pack}/scripts/tilefoundry_host_gate.py",
        "--cpu",
        "--timeout",
        "600"
      ],
      "configCheck": [
        "python3",
        "-B",
        "{pack}/scripts/tilefoundry_host_gate.py",
        "--check-config"
      ],
      "blockedExitCodes": [
        75
      ]
    },
    {
      "id": "tilefoundry-npu.device",
      "cwd": "source",
      "timeout": 660,
      "deviceWindow": {
        "waitSeconds": 60
      },
      "argv": [
        "python3",
        "-B",
        "{pack}/scripts/tilefoundry_host_gate.py",
        "--device",
        "--timeout",
        "600"
      ],
      "configCheck": [
        "python3",
        "-B",
        "{pack}/scripts/tilefoundry_host_gate.py",
        "--check-config-device"
      ],
      "blockedExitCodes": [
        75
      ]
    }
  ],
  "gates": [
    {
      "id": "tilefoundry-npu-cpu",
      "recipeId": "tilefoundry-npu.cpu",
      "gateType": "deterministic-test",
      "observationChecks": {
        "exitCodeZero": true,
        "testsCollectedPositive": true,
        "notAllSkipped": true,
        "testsFailed": 0
      }
    },
    {
      "id": "tilefoundry-npu-device",
      "recipeId": "tilefoundry-npu.device",
      "gateType": "deterministic-test",
      "observationChecks": {
        "exitCodeZero": true,
        "tilefoundryImported": true,
        "npuAvailable": true,
        "deviceCountOne": true,
        "tensorOnDevice": true,
        "fp32VectorOk": true,
        "bf16MatmulOk": true,
        "numericalOk": true,
        "synchronizeOk": true,
        "deviceMemoryPositive": true,
        "windowOpened": true,
        "windowReleased": true,
        "occupancyRecorded": true
      },
      "dependsOn": [
        "tilefoundry-npu-cpu"
      ]
    }
  ]
}
