# Example configuration for adapters/ascendnpu-ir/docker/create-container.sh
#
# Copy this file to `config.env` next to it and edit the values:
#
#     cp config.example.env config.env
#     ./create-container.sh --config ./config.env --dry-run
#     ./create-container.sh --config ./config.env
#
# `config.env` is git-ignored: it holds machine-specific identities and paths and
# must not be committed. The values below are an EXAMPLE for one machine; the
# scripts never hard-code them.
#
# Every value is plain Bash, so a list is a space-separated string and the
# script splits it on whitespace. Any value that contains spaces MUST be quoted
# (a bare `VAR=a b` would run `b` as a command when this file is sourced).

# ---------------------------------------------------------------------------
# Image and container identity
# ---------------------------------------------------------------------------
# Image built from ./Dockerfile (see README.md for the build command).
IMAGE=ascendnpu-ir-dev:24.04

# Name of the container to create. Must not already exist.
CONTAINER_NAME=

# Hostname inside the container. Defaults to CONTAINER_NAME.
# CONTAINER_HOSTNAME=

# Account created inside the container. The Adapter's
# ASCENDNPU_CONTAINER_USER must match this value.
CONTAINER_USER=

# UID/GID of that account. Set them to the Host account that owns the
# bind-mounted source tree AND the mounted home directory, so the container can
# write build products and read ~/.bashrc. Get the real values with:
#     stat -c '%u %g' /home/<user>
# A mismatch makes a login shell in the container fail with
# "Permission denied" on ~/.bashrc; create-container.sh rejects it on start.
CONTAINER_UID=
CONTAINER_GID=

# Supplementary GIDs added to the account. Leave empty if not needed. Common
# values are the host's HwHiAiUser group, so the container can reach NPU device
# nodes, and the docker group.
# SUPPLEMENTARY_GIDS="1000"

# HOME inside the container. Defaults to /home/<CONTAINER_USER>. This path is
# normally covered by the /home bind mount below; the scripts never create or
# chown it.
CONTAINER_HOME=

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
# Network mode. `host` is what NPU tooling typically expects.
NETWORK=host

# Run privileged. Required for many NPU/device operations.
PRIVILEGED=true

# cgroup namespace mode. `host` matches the reference environment.
CGROUPNS=host

# --security-opt values, space separated.
SECURITY_OPTS="label=disable"

# Shared memory size and locked-memory limit.
SHM_SIZE=512g
MEMLOCK=150000000000:150000000000

# Value of ASCEND_RT_VISIBLE_DEVICES inside the container.
ASCEND_VISIBLE_DEVICES=0,1

# Explicit device nodes to pass through (space separated). Leave empty when the
# host has no NPU or when the devices are already visible through --privileged.
# NPU_DEVICES="/dev/davinci0 /dev/davinci1 /dev/devmm_svm /dev/hisi_hdc"

# ---------------------------------------------------------------------------
# Mounts
# ---------------------------------------------------------------------------
# Required mounts, format `source:destination[:ro|rw]`. A missing source is a
# hard error: create-container.sh never lets Docker create an unexpected
# directory. `/home` and `/data` cover the usual source tree, CANN, Conda and
# dataset locations; the remaining entries are the Ascend Driver runtime.
BIND_MOUNTS="/data:/data /home:/home"

# Optional mounts, same format. A missing source is reported and skipped, not an
# error. This is where the hardware-specific paths belong, so the same script
# works on a machine without an NPU.
OPTIONAL_BIND_MOUNTS="/usr/local/Ascend/driver:/usr/local/Ascend/driver /etc/ascend_install.info:/etc/ascend_install.info /usr/local/sbin/npu-smi:/usr/local/sbin/npu-smi"

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------
# true:  keep the container alive after identity initialization (`tail -f
#        /dev/null`), which is what the Adapter needs.
# false: run CONTAINER_COMMAND instead; the container exits with it.
LONG_RUNNING=true

# Command run when LONG_RUNNING=false, for example:
# CONTAINER_COMMAND="/bin/bash -lc 'echo hello'"
CONTAINER_COMMAND=

# Seconds create-container.sh waits for the entrypoint to create and verify the
# container identity before it reports failure.
INIT_TIMEOUT_SECONDS=30
